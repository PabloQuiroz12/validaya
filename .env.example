# ============================================================================
# .env.example — Variables del ambiente QA de ValidaYa (Docker Compose)
# ============================================================================
# Copiar a .env y completar con valores reales. NUNCA commitear .env real.
# Los secretos están como placeholders dummy — generar reales con openssl.
# ============================================================================

# ─── Postgres (contenedor local) ────────────────────────────────────────────
POSTGRES_USER=validayaadmin
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=validaya_db
# face_db se crea adicional en init.sql con el mismo POSTGRES_USER

# ─── Backend Java (Spring Boot) ─────────────────────────────────────────────
# Spring respeta env vars con relaxed binding (PISA application.properties).
# Naming SPRING_DATASOURCE_* → spring.datasource.*
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/validaya_db
SPRING_DATASOURCE_USERNAME=validayaadmin
SPRING_DATASOURCE_PASSWORD=changeme-local-only
SERVER_PORT=8080

# JWT y AES — generar con: openssl rand -base64 32
# (usar valores DISTINTOS para JWT y AES — VAL-003 documenta por qué)
SECURITY_JWT_TOKEN_SECRET_KEY=REPLACE_WITH_openssl_rand_base64_32
VALIDAYA_AES_SECRET_KEY=REPLACE_WITH_DIFFERENT_openssl_rand_base64_32
SECURITY_JWT_TOKEN_EXPIRE_LENGTH=28800000

VALIDAYA_QR_CODE_EXPIRATION_TIME=30

# Stereum — sandbox / dummy. NO usar las del local.env del autor original
# (son credenciales personales suyas — VAL-004).
STEREUM_CALLBACK_URL=http://localhost:8080/stereum/callback
STEREUM_USERNAME=qa-team-placeholder@example.com
STEREUM_CLAVE_INTEGRACION=changeme-stereum-clave
STEREUM_BASE_URL=https://api.stereum.tech
STEREUM_CONNECT_TIMEOUT=5000
STEREUM_READ_TIMEOUT=10000
STEREUM_API_KEY=changeme-stereum-api-key
STEREUM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_REAL_PUBLIC_KEY\n-----END PUBLIC KEY-----"
STEREUM_MAX_RETRIES=3
STEREUM_RETRY_DELAY=1000
STEREUM_WEBHOOK_MAX_AGE=300
STEREUM_DEFAULT_CURRENCY=BOB
STEREUM_DEFAULT_COUNTRY=BO
STEREUM_DEFAULT_NETWORK=POLYGON
STEREUM_DEFAULT_BLOCKCHAIN_CURRENCY=USDT
STEREUM_TESTER_ENABLED=true

# Microservicio facial — URL interna en la red Docker.
# Backend resuelve "facial-recognition" vía DNS interno de Compose.
FACIAL_RECOGNITION_API_URL=http://facial-recognition:5000

# ─── Microservicio facial (Flask) ───────────────────────────────────────────
# DB separada para embeddings biométricos (decisión del grupo QA).
FACIAL_DB_HOST=postgres
FACIAL_DB_PORT=5432
FACIAL_DB_NAME=face_db
FACIAL_DB_USER=validayaadmin
FACIAL_DB_PASSWORD=changeme-local-only
FACIAL_PORT=5000
