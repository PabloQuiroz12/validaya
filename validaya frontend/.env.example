# ============================================================================
# .env.example — Frontend Vite (ValidaYa QA local)
# ============================================================================
# Copiar a .env.local para overridear default del código.
# Vite expone al cliente SOLO vars que empiezan con VITE_.
# ============================================================================

# URL del backend. En 4 archivos del código (authService.js, apiService.js,
# TramiteFlow.jsx x2) este valor pisa el default 'http://localhost:8080/api/v1'.
#
# ⚠️ Bug latente (VAL nuevo): src/services/api.js:1 hardcodea
# 'http://localhost:8081/api/v1' y NO respeta esta env var. Cualquier feature
# que use api.js va a fallar contra el backend en 8080. Documentado como
# defecto del producto, no se parchea desde QA.
VITE_API_URL=http://localhost:8080/api/v1
